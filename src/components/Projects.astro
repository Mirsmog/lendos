---
import { Icon } from 'astro-icon/components';

const projects = [
  {
    title: 'API Gateway',
    description: 'Высокопроизводительный API-шлюз с rate limiting, кэшированием и middleware pipeline. Обрабатывает 10k+ RPS.',
    tags: ['Go', 'Fiber', 'PostgreSQL', 'Redis'],
    status: 'Production',
    gradient: 'from-accent/20 to-accent/5',
  },
  {
    title: 'Task Manager',
    description: 'RESTful сервис управления задачами с JWT авторизацией, WebSocket уведомлениями и ролевой моделью доступа.',
    tags: ['Node.js', 'Express', 'MongoDB', 'JWT'],
    status: 'Production',
    gradient: 'from-[#3B82F6]/20 to-[#3B82F6]/5',
  },
  {
    title: 'CLI Tool',
    description: 'Утилита командной строки для автоматизации dev-процессов: scaffolding, деплой, управление конфигами.',
    tags: ['Go', 'Cobra', 'YAML'],
    status: 'Open Source',
    gradient: 'from-[#8B5CF6]/20 to-[#8B5CF6]/5',
  },
  {
    title: 'Monitoring Dashboard',
    description: 'Реал-тайм дашборд для мониторинга микросервисов с метриками, алертами и визуализацией логов.',
    tags: ['TypeScript', 'Node.js', 'Grafana', 'Docker'],
    status: 'In Progress',
    gradient: 'from-[#F97316]/20 to-[#F97316]/5',
  },
];
---

<div class="section-divider"></div>

<section id="projects" class="py-24 px-6">
  <div class="max-w-[1120px] mx-auto reveal">
    <h2 class="font-mono text-2xl md:text-[32px] font-bold mb-2">Projects</h2>
    <div class="w-12 h-0.5 bg-accent mb-4"></div>
    <p class="text-text-secondary mb-12 max-w-[600px]">Избранные проекты, над которыми я работал</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 reveal-stagger">
      {projects.map((project) => (
        <div class="glow-card group rounded-xl border border-border bg-card overflow-hidden
                    hover:border-accent/20 hover:shadow-[0_0_30px_rgba(16,185,129,0.06)]
                    transition-all duration-300">
          <!-- Gradient header -->
          <div class={`h-2 bg-gradient-to-r ${project.gradient}`}></div>
          
          <div class="p-6">
            <div class="flex items-start justify-between mb-3">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center text-accent">
                  <Icon name="lucide:folder-open" class="w-4 h-4" />
                </div>
                <h3 class="font-mono text-lg font-bold">{project.title}</h3>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[10px] font-mono text-accent border border-accent/20 bg-accent/5 px-2 py-1 rounded-full">
                  {project.status}
                </span>
                <a href="#" aria-label={`GitHub repo for ${project.title}`}
                   class="text-text-muted hover:text-accent transition-colors duration-200 min-w-[44px] min-h-[44px] flex items-center justify-center -mr-2">
                  <Icon name="simple-icons:github" class="w-5 h-5" />
                </a>
              </div>
            </div>

            <p class="text-sm text-text-secondary leading-relaxed mb-6">{project.description}</p>

            <div class="flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="px-3 py-1 text-xs font-mono text-text-muted border border-border rounded-full
                             group-hover:border-accent/20 group-hover:text-accent transition-all duration-200">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
