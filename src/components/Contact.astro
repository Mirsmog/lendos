---

---

<section id="contact" class="min-h-screen flex items-center snap-start py-24 px-6">
  <div class="max-w-[1120px] mx-auto w-full reveal">
    <h2 class="font-mono text-2xl md:text-[32px] font-bold mb-2">Contact</h2>
    <div class="w-12 h-0.5 bg-accent mb-12"></div>

    <!-- Interactive Terminal -->
    <div class="relative rounded-2xl border border-border bg-card max-w-[720px] mx-auto overflow-hidden shadow-[0_0_40px_rgba(16,185,129,0.06)]">
      <!-- Subtle glow -->
      <div class="absolute -top-24 -right-24 w-48 h-48 bg-accent/5 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Title bar -->
      <div class="flex items-center gap-2 px-4 py-3 border-b border-border">
        <span class="w-3 h-3 rounded-full bg-[#FF5F56]"></span>
        <span class="w-3 h-3 rounded-full bg-[#FFBD2E]"></span>
        <span class="w-3 h-3 rounded-full bg-[#27C93F]"></span>
        <span class="ml-2 text-xs text-text-muted font-mono">~/zwine/contact</span>
      </div>

      <!-- Terminal body -->
      <div class="px-5 py-5 font-mono text-sm leading-loose min-h-[280px]">
        <div id="contact-output" style="white-space: pre-wrap;">
          <p class="text-text-muted mb-1">Welcome! Type a command to get my contacts.</p>
          <p class="text-text-muted mb-4">Type <span class="text-accent">help</span> to see available commands.</p>
        </div>

        <!-- Input line -->
        <div class="flex items-center gap-0">
          <span class="text-text-muted shrink-0">~ </span>
          <span class="text-accent shrink-0">$ </span>
          <div class="relative flex-1">
            <input
              id="contact-input"
              type="text"
              class="w-full bg-transparent border-none outline-none text-text caret-accent font-mono text-sm p-0"
              placeholder="type help..."
              autocomplete="off"
              spellcheck="false"
              aria-label="Terminal command input"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Hint chips below terminal -->
    <div class="flex items-center justify-center gap-2 mt-6 flex-wrap">
      <span class="text-xs text-text-muted">Try:</span>
      <button class="contact-chip px-3 py-1 text-xs font-mono text-accent/70 border border-accent/15 rounded-full hover:border-accent/30 hover:text-accent transition-all duration-200 cursor-pointer bg-transparent">help</button>
      <button class="contact-chip px-3 py-1 text-xs font-mono text-accent/70 border border-accent/15 rounded-full hover:border-accent/30 hover:text-accent transition-all duration-200 cursor-pointer bg-transparent">contacts</button>
      <button class="contact-chip px-3 py-1 text-xs font-mono text-accent/70 border border-accent/15 rounded-full hover:border-accent/30 hover:text-accent transition-all duration-200 cursor-pointer bg-transparent">github</button>
      <button class="contact-chip px-3 py-1 text-xs font-mono text-accent/70 border border-accent/15 rounded-full hover:border-accent/30 hover:text-accent transition-all duration-200 cursor-pointer bg-transparent">telegram</button>
    </div>
  </div>
</section>

<script>
  const input = document.getElementById('contact-input') as HTMLInputElement;
  const output = document.getElementById('contact-output') as HTMLElement;

  const commands: Record<string, { output: string; action?: () => void }> = {
    help: {
      output: `<span class="text-accent">Available commands:</span>
<span class="text-text-secondary">  contacts</span>    — Show all contact links
<span class="text-text-secondary">  github</span>      — Open GitHub profile
<span class="text-text-secondary">  telegram</span>    — Open Telegram
<span class="text-text-secondary">  email</span>       — Copy email address
<span class="text-text-secondary">  clear</span>       — Clear terminal
<span class="text-text-secondary">  help</span>        — Show this help message`,
    },
    contacts: {
      output: `<span class="text-accent">┌───────────────────────────┐</span>
<span class="text-accent">│</span>  📫 Contact Information    <span class="text-accent">│</span>
<span class="text-accent">├───────────────────────────┤</span>
<span class="text-accent">│</span>  → <a href="https://github.com/Mirsmog" target="_blank" rel="noopener" class="text-accent hover:underline">GitHub</a>
<span class="text-accent">│</span>  → <a href="https://t.me/zwine02" target="_blank" rel="noopener" class="text-accent hover:underline">Telegram</a>
<span class="text-accent">│</span>  → <a href="mailto:tanharka.tyuchiev4@gmail.com" class="text-accent hover:underline">Email</a>
<span class="text-accent">└───────────────────────────┘</span>`,
    },
    github: {
      output: '<span class="text-text-secondary">Opening GitHub...</span> <a href="https://github.com/Mirsmog" target="_blank" rel="noopener" class="text-accent hover:underline">github.com/Mirsmog</a>',
      action: () => window.open('https://github.com/Mirsmog', '_blank'),
    },
    telegram: {
      output: '<span class="text-text-secondary">Opening Telegram...</span> <a href="https://t.me/zwine02" target="_blank" rel="noopener" class="text-accent hover:underline">@zwine02</a>',
      action: () => window.open('https://t.me/zwine02', '_blank'),
    },
    email: {
      output: '<span class="text-accent">✓</span> <span class="text-text-secondary">Email copied to clipboard:</span> <span class="text-accent">tanharka.tyuchiev4@gmail.com</span>',
      action: () => navigator.clipboard?.writeText('tanharka.tyuchiev4@gmail.com'),
    },
    clear: { output: '__CLEAR__' },
  };

  function addLine(html: string) {
    const div = document.createElement('div');
    div.innerHTML = html;
    div.style.animation = 'countUp 0.3s ease-out both';
    output.appendChild(div);
  }

  function processCommand(cmd: string) {
    const trimmed = cmd.trim().toLowerCase();

    // Echo the command
    addLine(`<p><span class="text-text-muted">~ </span><span class="text-accent">$</span> <span class="text-text-secondary">${cmd}</span></p>`);

    if (!trimmed) return;

    if (trimmed === 'clear') {
      output.innerHTML = '';
      return;
    }

    const match = commands[trimmed];
    if (match) {
      addLine(`<div class="my-2 whitespace-pre">${match.output}</div>`);
      match.action?.();
    } else {
      addLine(`<p class="text-[#F87171]">command not found: ${trimmed}</p><p class="text-text-muted">Type <span class="text-accent">help</span> for available commands.</p>`);
    }

    // Auto-scroll
    setTimeout(() => {
      output.parentElement?.scrollTo({ top: output.parentElement.scrollHeight, behavior: 'smooth' });
    }, 50);
  }

  if (input) {
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        processCommand(input.value);
        input.value = '';
      }
    });

    // Click anywhere in terminal to focus input
    input.closest('.rounded-2xl')?.addEventListener('click', () => input.focus());

    // Chip buttons
    document.querySelectorAll('.contact-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const cmd = chip.textContent?.trim() || '';
        input.value = cmd;
        processCommand(cmd);
        input.value = '';
        input.focus();
      });
    });
  }
</script>
