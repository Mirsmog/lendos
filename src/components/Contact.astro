---

---

<div class="section-divider"></div>

<section id="contact" class="py-24 px-6">
  <div class="max-w-[1120px] mx-auto reveal">
    <h2 class="font-mono text-2xl md:text-[32px] font-bold mb-2">Contact</h2>
    <div class="w-12 h-0.5 bg-accent mb-12"></div>

    <!-- CTA Card -->
    <div class="relative rounded-2xl border border-border bg-card p-8 md:p-12 max-w-[720px] mx-auto overflow-hidden">
      <!-- Subtle glow -->
      <div class="absolute -top-24 -right-24 w-48 h-48 bg-accent/5 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="relative text-center">
        <div class="w-16 h-16 rounded-2xl bg-accent/10 flex items-center justify-center mx-auto mb-6">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-accent">
            <path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/>
          </svg>
        </div>
        
        <h3 class="font-mono text-xl md:text-2xl font-bold mb-4">Давайте работать вместе</h3>
        <p class="text-text-secondary mb-8 max-w-[480px] mx-auto leading-relaxed">
          Открыт для предложений, фриланс-проектов и сотрудничества. 
          Напишите мне — обсудим вашу идею.
        </p>

        <div class="flex items-center justify-center gap-4 flex-wrap">
          <!-- GitHub -->
          <a href="https://github.com" target="_blank" rel="noopener noreferrer"
             class="flex items-center gap-3 px-5 py-3 rounded-xl border border-border bg-bg
                    hover:border-accent/30 hover:bg-accent/[0.03] transition-all duration-200 min-h-[48px]">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-text-secondary">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844a9.59 9.59 0 012.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span class="text-sm text-text-secondary">GitHub</span>
          </a>

          <!-- Telegram -->
          <a href="https://t.me/" target="_blank" rel="noopener noreferrer"
             class="flex items-center gap-3 px-5 py-3 rounded-xl border border-border bg-bg
                    hover:border-accent/30 hover:bg-accent/[0.03] transition-all duration-200 min-h-[48px]">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-text-secondary">
              <path d="M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0a12 12 0 00-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
            <span class="text-sm text-text-secondary">Telegram</span>
          </a>

          <!-- Email -->
          <a href="mailto:hello@example.com"
             class="flex items-center gap-3 px-5 py-3 rounded-xl border border-border bg-bg
                    hover:border-accent/30 hover:bg-accent/[0.03] transition-all duration-200 min-h-[48px]">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-text-secondary">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="M22 7l-8.97 5.7a1.94 1.94 0 01-2.06 0L2 7"/>
            </svg>
            <span class="text-sm text-text-secondary">Email</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
