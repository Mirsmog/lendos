---

---

<section class="min-h-screen flex items-center justify-center px-6 pt-16 relative overflow-hidden">
  <!-- Background glow blobs -->
  <div class="glow-blob -top-32 -right-32 opacity-60"></div>
  <div class="glow-blob -bottom-48 -left-48 opacity-40"></div>

  <div class="max-w-[1120px] w-full flex flex-col lg:flex-row items-center gap-16 animate-fade-in relative z-10">
    <!-- Left: Text content -->
    <div class="flex-1 flex flex-col items-center lg:items-start text-center lg:text-left gap-6">
      <!-- Badge -->
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-accent/20 bg-accent/5 text-xs font-mono text-accent">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        Available for hire
      </span>

      <h1 class="font-mono text-4xl md:text-5xl lg:text-[56px] font-bold leading-tight">
        Hi, I'm <span class="text-accent">Timur</span>
      </h1>

      <p class="text-lg md:text-xl text-text-secondary max-w-[480px]">
        Fullstack-разработчик, создающий быстрые и надёжные серверные системы
      </p>

      <div class="flex items-center gap-3 text-sm text-text-muted">
        <span class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>Go
        </span>
        <span class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>Node.js
        </span>
        <span class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>JavaScript
        </span>
      </div>

      <div class="flex items-center gap-4 mt-2">
        <a
          href="#projects"
          class="inline-flex items-center gap-2 px-8 py-3 rounded-lg bg-accent text-bg font-bold text-sm
                 hover:bg-accent-hover active:bg-accent-pressed transition-all duration-200
                 hover:shadow-[0_0_24px_rgba(16,185,129,0.25)] min-h-[44px]"
        >
          Смотреть проекты
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V7.8H7.8"/></svg>
        </a>
        <a
          href="#contact"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-border text-text-secondary text-sm
                 hover:border-accent/30 hover:text-accent transition-all duration-200 min-h-[44px]"
        >
          Связаться
        </a>
      </div>
    </div>

    <!-- Right: Terminal -->
    <div class="flex-1 max-w-[520px] w-full">
      <div class="rounded-xl border border-border bg-card overflow-hidden shadow-[0_0_40px_rgba(16,185,129,0.06)]">
        <!-- Title bar -->
        <div class="flex items-center gap-2 px-4 py-3 border-b border-border bg-card">
          <span class="w-3 h-3 rounded-full bg-[#FF5F56]"></span>
          <span class="w-3 h-3 rounded-full bg-[#FFBD2E]"></span>
          <span class="w-3 h-3 rounded-full bg-[#27C93F]"></span>
          <span class="ml-2 text-xs text-text-muted font-mono">~/zwine</span>
        </div>
        <!-- Terminal content -->
        <div class="px-5 py-5 font-mono text-sm leading-loose">
          <p><span class="text-text-muted">~</span> <span class="text-accent">$</span> <span class="text-text-secondary">whoami</span></p>
          <p class="text-text">Timur — Fullstack Developer</p>
          <p class="mt-3"><span class="text-text-muted">~</span> <span class="text-accent">$</span> <span class="text-text-secondary">cat skills.json</span></p>
          <p class="text-text-muted">{"{"}</p>
          <p class="pl-4"><span class="text-accent">"languages"</span>: <span class="text-text-secondary">["Go", "JS", "TS"]</span>,</p>
          <p class="pl-4"><span class="text-accent">"backend"</span>: <span class="text-text-secondary">["Node.js", "Fiber"]</span>,</p>
          <p class="pl-4"><span class="text-accent">"tools"</span>: <span class="text-text-secondary">["Docker", "PostgreSQL"]</span></p>
          <p class="text-text-muted">{"}"}</p>
          <p class="mt-3"><span class="text-text-muted">~</span> <span class="text-accent">$</span> <span class="text-text-secondary">uptime --dev</span></p>
          <p class="text-text">3+ years building production systems</p>
          <p class="mt-3"><span class="text-text-muted">~</span> <span class="text-accent">$</span> <span class="cursor-blink text-accent">▊</span></p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fadeIn 0.7s ease-out both;
  }
</style>
