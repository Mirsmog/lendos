---
import { Icon } from 'astro-icon/components';
---

<section class="min-h-screen flex items-center justify-center px-6 pt-16 snap-start relative overflow-hidden">
  <!-- Background glow blobs -->
  <div class="glow-blob -top-32 -right-32 opacity-60"></div>
  <div class="glow-blob -bottom-48 -left-48 opacity-40"></div>

  <div class="max-w-[1120px] w-full flex flex-col lg:flex-row items-center gap-16 animate-fade-in relative z-10">
    <!-- Left: Text content -->
    <div class="flex-1 flex flex-col items-center lg:items-start text-center lg:text-left gap-6">
      <h1 class="font-mono text-4xl md:text-5xl lg:text-[56px] font-bold leading-tight">
        Hi, I'm <span class="text-accent">Timur</span>
      </h1>

      <p class="text-lg md:text-xl text-text-secondary max-w-[480px]">
        Fullstack developer crafting fast and reliable server-side systems
      </p>

      <div class="flex items-center gap-3 text-sm text-text-muted">
        <span class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>Go
        </span>
        <span class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>Node.js
        </span>
        <span class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>JavaScript
        </span>
      </div>

      <div class="flex items-center gap-4 mt-2">
        <a
          href="#projects"
          class="inline-flex items-center gap-2 px-8 py-3 rounded-lg bg-accent text-bg font-bold text-sm
                 hover:bg-accent-hover active:bg-accent-pressed transition-all duration-200
                 hover:shadow-[0_0_24px_rgba(16,185,129,0.25)] min-h-[44px]"
        >
          View Projects
          <Icon name="lucide:arrow-up-right" class="w-4 h-4" />
        </a>
        <a
          href="#contact"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-border text-text-secondary text-sm
                 hover:border-accent/30 hover:text-accent transition-all duration-200 min-h-[44px]"
        >
          Get in Touch
        </a>
      </div>
    </div>

    <!-- Right: Terminal -->
    <div class="flex-1 max-w-[520px] w-full">
      <div class="rounded-xl border border-border bg-card overflow-hidden shadow-[0_0_40px_rgba(16,185,129,0.06)]">
        <!-- Title bar -->
        <div class="flex items-center gap-2 px-4 py-3 border-b border-border bg-card">
          <span class="w-3 h-3 rounded-full bg-[#FF5F56]"></span>
          <span class="w-3 h-3 rounded-full bg-[#FFBD2E]"></span>
          <span class="w-3 h-3 rounded-full bg-[#27C93F]"></span>
          <span class="ml-2 text-xs text-text-muted font-mono">~/zwine</span>
        </div>
        <!-- Terminal content -->
        <div id="hero-terminal" class="px-5 py-5 font-mono text-sm leading-loose min-h-[240px]">
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const terminal = document.getElementById('hero-terminal');
  if (terminal) {
    const lines: { text: string; class: string; delay: number }[] = [
      { text: '~ $ whoami', class: 'cmd', delay: 0 },
      { text: 'Timur — Fullstack Developer', class: 'out', delay: 600 },
      { text: '', class: 'br', delay: 900 },
      { text: '~ $ cat skills.json', class: 'cmd', delay: 1000 },
      { text: '{', class: 'dim', delay: 1500 },
      { text: '  "languages": ["Go", "JS", "TS"],', class: 'json', delay: 1600 },
      { text: '  "backend":   ["Node.js", "Fiber"],', class: 'json', delay: 1700 },
      { text: '  "tools":     ["Docker", "PostgreSQL"]', class: 'json', delay: 1800 },
      { text: '}', class: 'dim', delay: 1900 },
      { text: '', class: 'br', delay: 2100 },
      { text: '~ $ uptime --dev', class: 'cmd', delay: 2200 },
      { text: '3+ years building production systems', class: 'out', delay: 2700 },
      { text: '', class: 'br', delay: 3000 },
      { text: '~ $ _', class: 'cursor', delay: 3100 },
    ];

    function formatCmd(text: string): string {
      return text
        .replace(/^(~ )(\$)( .*)$/, '<span class="text-text-muted">$1</span><span class="text-accent">$2</span><span class="text-text-secondary">$3</span>');
    }

    function formatJson(text: string): string {
      return text
        .replace(/"([^"]+)":/g, '<span class="text-accent">"$1"</span>:')
        .replace(/\[([^\]]+)\]/g, '<span class="text-text-secondary">[$1]</span>');
    }

    async function typeText(el: HTMLElement, text: string, speed = 30): Promise<void> {
      for (let i = 0; i < text.length; i++) {
        el.innerHTML += text[i] === ' ' ? '&nbsp;' : text[i];
        await new Promise(r => setTimeout(r, speed + Math.random() * 20));
      }
    }

    async function runTerminal() {
      for (const line of lines) {
        await new Promise(r => setTimeout(r, line.delay ? 200 : 0));

        if (line.class === 'br') {
          terminal.appendChild(document.createElement('br'));
          continue;
        }

        const p = document.createElement('p');

        if (line.class === 'cursor') {
          p.innerHTML = '<span class="text-text-muted">~ </span><span class="text-accent">$</span> <span class="cursor-blink text-accent">▊</span>';
          terminal.appendChild(p);
          continue;
        }

        if (line.class === 'cmd') {
          terminal.appendChild(p);
          const prefix = '<span class="text-text-muted">~ </span><span class="text-accent">$</span> ';
          p.innerHTML = prefix;
          const cmdText = line.text.replace('~ $ ', '');
          const span = document.createElement('span');
          span.className = 'text-text-secondary';
          p.appendChild(span);
          await typeText(span, cmdText, 35);
          await new Promise(r => setTimeout(r, 300));
        } else if (line.class === 'json') {
          p.innerHTML = formatJson(line.text);
          p.classList.add('pl-4');
          terminal.appendChild(p);
        } else if (line.class === 'dim') {
          p.className = 'text-text-muted';
          p.textContent = line.text;
          terminal.appendChild(p);
        } else {
          p.className = 'text-text';
          p.textContent = line.text;
          terminal.appendChild(p);
        }
      }
    }

    // Start when terminal scrolls into view
    const obs = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        obs.disconnect();
        runTerminal();
      }
    }, { threshold: 0.3 });
    obs.observe(terminal);
  }
</script>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fadeIn 0.7s ease-out both;
  }
</style>
