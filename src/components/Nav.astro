---
const links = [
  { label: 'About', href: '#about' },
  { label: 'Skills', href: '#skills' },
  { label: 'Projects', href: '#projects' },
  { label: 'Contact', href: '#contact' },
];
---

<nav class="fixed top-0 left-0 w-full z-50 backdrop-blur-md bg-bg/80 border-b border-border">
  <div class="max-w-[1120px] mx-auto px-6 flex items-center justify-between h-16">
    <a href="/" class="font-mono text-xl font-semibold text-accent">Zwine</a>

    <!-- Desktop links -->
    <ul class="hidden md:flex items-center gap-8">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-sm text-text-secondary hover:text-accent transition-colors duration-200"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile hamburger -->
    <button
      id="menu-toggle"
      class="md:hidden flex flex-col gap-1.5 p-2 -mr-2 min-w-[44px] min-h-[44px] items-center justify-center"
      aria-label="Toggle menu"
    >
      <span class="block w-5 h-0.5 bg-text-secondary transition-transform duration-200" id="bar1"></span>
      <span class="block w-5 h-0.5 bg-text-secondary transition-opacity duration-200" id="bar2"></span>
      <span class="block w-5 h-0.5 bg-text-secondary transition-transform duration-200" id="bar3"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-border bg-bg/95 backdrop-blur-md">
    <ul class="flex flex-col items-center gap-2 py-4">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="block px-6 py-3 text-base text-text-secondary hover:text-accent transition-colors duration-200 min-h-[44px] flex items-center"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const bar1 = document.getElementById('bar1');
  const bar2 = document.getElementById('bar2');
  const bar3 = document.getElementById('bar3');

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    bar1!.style.transform = open ? 'rotate(45deg) translate(3px, 3px)' : '';
    bar2!.style.opacity = open ? '0' : '1';
    bar3!.style.transform = open ? 'rotate(-45deg) translate(3px, -3px)' : '';
  });

  document.querySelectorAll('#mobile-menu a').forEach((a) => {
    a.addEventListener('click', () => menu?.classList.add('hidden'));
  });
</script>
