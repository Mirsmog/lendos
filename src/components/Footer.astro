---
import { Icon } from 'astro-icon/components';

const navLinks = [
  { label: 'About', href: '#about' },
  { label: 'Skills', href: '#skills' },
  { label: 'Projects', href: '#projects' },
  { label: 'Contact', href: '#contact' },
];

const socialLinks = [
  { name: 'GitHub', href: 'https://github.com/zwine', icon: 'simple-icons:github' },
  { name: 'Telegram', href: 'https://t.me/zwine', icon: 'simple-icons:telegram' },
];
---

<footer class="snap-start border-t border-border pt-12 pb-8 px-6">
  <div class="max-w-[1120px] mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      <!-- Brand -->
      <div>
        <a href="/" class="font-mono text-xl font-bold text-accent">Zwine</a>
        <p class="text-sm text-text-muted mt-3 max-w-[280px] leading-relaxed">
          Fullstack developer building fast, reliable systems with Go and Node.js.
        </p>
        <div class="flex items-center gap-3 mt-4">
          {socialLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.name}
               class="w-9 h-9 rounded-lg border border-border bg-card flex items-center justify-center
                      text-text-muted hover:text-accent hover:border-accent/20 transition-all duration-200">
              <Icon name={link.icon} class="w-4 h-4" />
            </a>
          ))}
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h4 class="text-xs font-bold text-text-muted uppercase tracking-wider mb-4">Navigation</h4>
        <ul class="space-y-2">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-text-secondary hover:text-accent transition-colors duration-200">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Terminal snippet -->
      <div>
        <h4 class="text-xs font-bold text-text-muted uppercase tracking-wider mb-4">Built with</h4>
        <div class="rounded-lg border border-border bg-bg p-4 font-mono text-xs">
          <p><span class="text-accent">$</span> <span class="text-text-muted">cat stack.txt</span></p>
          <p class="text-text-secondary mt-1">Astro v5</p>
          <p class="text-text-secondary">Tailwind CSS v4</p>
          <p class="text-text-secondary">Three.js</p>
          <p class="text-text-secondary">TypeScript</p>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-border pt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-text-muted">© 2026 Zwine. All rights reserved.</p>
      <p class="text-xs text-text-muted flex items-center gap-1">
        Made with <span class="text-accent">♥</span> and too much coffee
      </p>
    </div>
  </div>
</footer>
