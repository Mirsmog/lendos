---
import { Icon } from 'astro-icon/components';

const categories = [
  {
    label: 'Languages',
    skills: [
      { name: 'Go', desc: 'Microservices, CLI', iconName: 'simple-icons:go' },
      { name: 'JavaScript', desc: 'Fullstack, ES2024+', iconName: 'simple-icons:javascript' },
      { name: 'TypeScript', desc: 'Type safety, DX', iconName: 'simple-icons:typescript' },
    ],
  },
  {
    label: 'Backend',
    skills: [
      { name: 'Node.js', desc: 'APIs, Servers', iconName: 'simple-icons:nodedotjs' },
      { name: 'Express', desc: 'REST API', iconName: 'simple-icons:express' },
      { name: 'Fiber', desc: 'Go web framework', iconName: 'simple-icons:go' },
    ],
  },
  {
    label: 'Tools & Infra',
    skills: [
      { name: 'Docker', desc: 'Containerization', iconName: 'simple-icons:docker' },
      { name: 'Git', desc: 'Version control', iconName: 'simple-icons:git' },
      { name: 'Linux', desc: 'Server environment', iconName: 'simple-icons:linux' },
      { name: 'PostgreSQL', desc: 'Relational databases', iconName: 'simple-icons:postgresql' },
    ],
  },
];
---

<section id="skills" class="min-h-screen flex items-center snap-start py-24 px-6">
  <div class="max-w-[1120px] mx-auto w-full reveal">
    <h2 class="font-mono text-2xl md:text-[32px] font-bold mb-2">Tech Stack</h2>
    <div class="w-12 h-0.5 bg-accent mb-4"></div>
    <p class="text-text-secondary mb-12 max-w-[600px]">Tools and technologies I work with every day</p>

    <div class="grid gap-12">
      {categories.map((cat) => (
        <div>
          <h3 class="text-xs font-bold text-accent uppercase tracking-widest mb-6 flex items-center gap-2">
            <span class="w-6 h-px bg-accent"></span>
            {cat.label}
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 reveal-stagger">
            {cat.skills.map((skill) => (
              <div class="glow-card group flex items-center gap-4 p-5 rounded-xl border border-border bg-card
                          hover:border-accent/20 hover:bg-accent/[0.03] hover:shadow-[0_0_20px_rgba(16,185,129,0.06)]
                          transition-all duration-200 min-h-[72px]">
                <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-accent/10 text-accent
                            group-hover:bg-accent/15 transition-colors duration-200 shrink-0">
                  <Icon name={skill.iconName} class="w-6 h-6" />
                </div>
                <div>
                  <span class="text-sm font-bold block">{skill.name}</span>
                  <span class="text-xs text-text-muted">{skill.desc}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
